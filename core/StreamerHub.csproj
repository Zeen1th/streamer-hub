<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StreamerHub.Core</RootNamespace>
    <AssemblyName>StreamerHub</AssemblyName>
    <ApplicationIcon>..\assets\streamer-hub-icon.ico</ApplicationIcon>
    <Version>0.2.5</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\dist\**\*" Exclude="..\dist\src\chat-overlay.html" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <Content Include="..\dist\src\chat-overlay.html" Link="wwwroot\chat-overlay.html" CopyToOutputDirectory="Always" />
    <Content Include="..\assets\streamer-hub-icon.ico" Link="streamer-hub-icon.ico" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>

